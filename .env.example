# Copie para .env e preencha só o que for usar. Sem .env, o app sobe em modo demo.

# dev | production
APP_ENV=dev
DATABASE_URL=sqlite:///./var/app.db
CLINIC_DATA_PATH=data/clinica.yaml
DEMO_SEED=true
# Mensagens por minuto por IP no simulador web
SIMULATOR_RATE_LIMIT_PER_MINUTE=30

# Painel do atendente. SESSION_SECRET vazio = gerado na inicialização (sessões caem ao reiniciar).
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# WhatsApp Cloud API (todas preenchidas = WhatsApp ligado). Ver docs/whatsapp-setup.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# Opções como botões/listas interativas (false = texto com lista numerada)
WHATSAPP_INTERACTIVE=true
# Lembrete antes da consulta: exige template aprovado na Meta (ver docs/whatsapp-setup.md)
REMINDERS_ENABLED=false
WHATSAPP_REMINDER_TEMPLATE=lembrete_consulta
WHATSAPP_REMINDER_LANGUAGE=pt_BR
REMINDER_HOURS_BEFORE=24

# IA de reserva (qualquer API compatível com OpenAI: Groq, OpenAI, Ollama).
LLM_ENABLED=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
# Limites de uso (proteção do plano gratuito e contra abuso)
LLM_MAX_QUESTION_CHARS=300
LLM_CALLS_PER_CONTACT_PER_HOUR=10
LLM_DAILY_CAP=200

# Transcrição de áudios do WhatsApp (Whisper), com o mesmo LLM_BASE_URL/LLM_API_KEY
AUDIO_TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_MODEL=whisper-large-v3
